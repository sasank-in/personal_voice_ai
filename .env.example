APP_ENV=development
APP_NAME=Personal Voice AI
SESSION_SECRET=replace_me

# PostgreSQL. DATABASE_URL, if set, takes priority over these.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_me
DB_NAME=voice_db

SARVAM_API_KEY=replace_me
SARVAM_STT_MODEL=saaras:v4

# STT_PROVIDER is sarvam or groq.
STT_PROVIDER=sarvam

# LLM_PROVIDER is groq or xai. Each has a default model; LLM_MODEL overrides it.
LLM_PROVIDER=groq
GROQ_API_KEY=replace_me
# XAI_API_KEY=replace_me
# LLM_MODEL=openai/gpt-oss-120b

MAX_AUDIO_UPLOAD_MB=20
MAX_UTTERANCE_SECONDS=29
AUDIO_STORAGE_DIR=storage
CORS_ORIGINS=http://localhost:5173
