# Copy to .env.production on the server. Never commit the copy.

# Your public domain, with DNS pointing at this server. Caddy gets the HTTPS certificate for it.
DOMAIN=voice.example.com

# Generate each with: openssl rand -hex 32
SESSION_SECRET=replace_me
DB_PASSWORD=replace_me

DB_USER=voice_ai
DB_NAME=voice_ai

SARVAM_API_KEY=replace_me
GROQ_API_KEY=replace_me
# XAI_API_KEY=replace_me

STT_PROVIDER=sarvam
LLM_PROVIDER=groq

# Anyone who can reach the site can sign up, and every account spends your provider credits.
# Set to false once your own account exists, unless you want public sign-up.
SIGNUP_ENABLED=true
